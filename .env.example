NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=https://tu-dominio.vercel.app
NEXT_PUBLIC_WHATSAPP_NUMBER=51921682529
NEXT_PUBLIC_YAPE_NUMBER="999 999 999"
NEXT_PUBLIC_PLIN_NUMBER="999 999 999"

# SEO: código de verificación de Google Search Console (solo el valor del meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Analytics: ID de medición de GA4 (G-XXXXXXX). Vacío = GA4 desactivado.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Invitaciones a reseñar (cron horario en Vercel)
CRON_SECRET=genera-un-secreto-largo-aqui
REVIEW_INVITE_MIN_HOURS=24
# Techo de seguridad para no escribir a reservas muy antiguas (336 = 14 días)
REVIEW_INVITE_MAX_HOURS=336
# trip = 24h después del tour/hotel · booking = 24h después de crear la reserva
REVIEW_INVITE_AFTER=booking

# WhatsApp automático al cliente (elige uno):
# Opción A — Green API (recomendado en Perú): https://green-api.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
# Opcional: host de tu instancia (default https://7103.api.greenapi.com)
GREEN_API_HOST=
# Opción B — Meta WhatsApp Cloud API
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_REVIEW_TEMPLATE=

# Notificaciones por correo (Resend: https://resend.com)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Zarpa <reservas@tudominio.com>
ZARPA_OPS_EMAIL=tu@correo.com
